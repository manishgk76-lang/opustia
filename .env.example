# PostgreSQL (used by the API and Prisma)
DATABASE_URL="postgresql://opustia:opustia_dev_password@localhost:5432/opustia?schema=public"

# API runtime
NODE_ENV="development"
PORT="4000"
API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:5173"
MOBILE_SCHEME="opustia"

# Generate unique high-entropy values for every non-local environment.
JWT_ACCESS_SECRET="replace-with-a-32-character-minimum-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-minimum-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Optional Razorpay test credentials. Leave empty to run without payment-provider calls.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Upload and notifications are intentionally adapter-based.
UPLOAD_DIR="uploads"
EXPO_ACCESS_TOKEN=""

# Admin bootstrap account used only by the seed script.
SEED_ADMIN_EMAIL="admin@opustia.test"
SEED_ADMIN_PASSWORD="AdminPass123!"
